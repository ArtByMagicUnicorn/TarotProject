@* OBS: Nu tar vi emot en lista av 'DrawnCard' *@
@model IEnumerable<Tarot.Web.Models.DrawnCard>

@{
    ViewData["Title"] = "Tre kort: Dåtid, Nutid, Framtid";
}

<h1 class="text-center">@ViewData["Title"]</h1>
<p class="text-center">Här är din läggning med tre kort.</p>

<hr />

<div class="row">

    @for (int i = 0; i < Model.Count(); i++)
    {
        var item = Model.ElementAt(i); // Detta är vårt 'DrawnCard' wrapper
        var card = item.Card;          // Detta är själva kortet

        // Vi sätter rubriken beroende på vilket nummer i loopen vi är på
        string title = i == 0 ? "Dåtid" : (i == 1 ? "Nutid" : "Framtid");

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header text-center">
                    <strong>@title</strong>
                    @if (item.IsReversed)
                    {
                        <span class="badge bg-warning text-dark ms-2">Omvänd</span>
                    }
                </div>

                <div style="overflow: hidden;">
                    <img src="~/images/@(card.Name).jpg"
                         class="card-img-top"
                         alt="@card.Name"
                         style="width: 100%; height: auto; transition: transform 0.5s; @(item.IsReversed ? "transform: rotate(180deg);" : "")">
                </div>

                <div class="card-body">
                    <h5 class="card-title text-center">@card.Name</h5>

                    @foreach (var meaning in card.Meanings)
                    {
                        // Om kortet är omvänt OCH kategorin är "Omvänd"... VISA!
                        // ELLER om kortet är rättvänt OCH kategorin är "Upprätt"... VISA!

                        bool showThis = false;
                        if (item.IsReversed && meaning.MeaningCategory.CategoryName == "Omvänd") { showThis = true; }
                        if (!item.IsReversed && meaning.MeaningCategory.CategoryName == "Upprätt") { showThis = true; }

                        if (showThis)
                        {
                            <p class="card-text small mt-3">
                                <strong>@meaning.MeaningCategory.CategoryName:</strong><br />
                                @meaning.Text
                            </p>
                        }
                    }
                </div>
            </div>
        </div>
    }

</div>

<hr />

<div class="row justify-content-center mt-4">
    <div class="col-md-9">
        <h2 class="text-center">Din Egen Tolkning</h2>
        <p class="text-center text-muted">Skriv ner dina tankar och känslor om läggningen.</p>
        <form>
            <div class="mb-3">
                <label for="userNotes" class="form-label">Mina anteckningar:</label>
                <textarea class="form-control" id="userNotes" rows="8" placeholder="Skriv här..."></textarea>
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-primary disabled" title="Kommer snart!">Spara i Dagboken</button>
            </div>
        </form>
    </div>
</div>

<hr />

<div class="text-center">
    <a href="/tarot/threecardspread" class="btn-grad" style="display: inline-block; width: auto;">Dra en ny läggning</a>
</div>